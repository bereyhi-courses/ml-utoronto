    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MLE mean: -0.001298, MLE variance: 0.002332, sigma: 0.048290\n"
     ]
    }
   ],
   "source": [
    "def mle_gaussian_parameters(x):\n",
    "    n = x.size\n",
    "    mu_hat = x.mean()\n",
    "    var_hat = ((x - mu_hat) ** 2).mean()  # MLE divisor = n\n",
    "    return mu_hat, var_hat\n",
    "\n",
    "mu_mle, var_mle = mle_gaussian_parameters(X_train)\n",
    "sigma_mle = np.sqrt(var_mle)\n",
    "print(f\"MLE mean: {mu_mle:.6f}, MLE variance: {var_mle:.6f}, sigma: {sigma_mle:.6f}\")"
   ]
  },

    "# Generate synthetic binary classification data\n",
    "np.random.seed(42)\n",
    "X = np.random.randn(100, 1)\n",
    "y = (3 * X + 2 + np.random.randn(100, 1) * 0.5 > 3).astype(float)  # Binary labels\n",
    "\n",
    "# Convert to PyTorch tensors\n",
    "X_torch = torch.tensor(X, dtype=torch.float32)\n",
    "y_torch = torch.tensor(y, dtype=torch.float32)\n",
    "\n",
    "# Initialize parameters with gradient tracking\n",
    "w = torch.tensor([[1.0]], requires_grad=True)\n",
    "b = torch.tensor([0.0], requires_grad=True)\n",
    "\n",
    "# Learning rate and number of iterations\n",
    "learning_rate = 0.01\n",
    "num_iterations = 10000\n",
    "\n",
    "# Training loop\n",
    "losses = []\n",
    "for iteration in range(num_iterations):\n",
    "\t# Forward pass: sigmoid(w*X + b)\n",
    "\tlogits = X_torch @ w + b\n",
    "\ty_pred = torch.sigmoid(logits)\n",
    "\t\n",
    "\t# Compute loss (Binary Cross Entropy)\n",
    "\tloss = -(y_torch * torch.log(y_pred + 1e-8) + (1 - y_torch) * torch.log(1 - y_pred + 1e-8)).mean()\n",
    "\tlosses.append(loss.item())\n",
    "\t\n",
    "\t# Backward pass: compute gradients\n",
    "\tloss.backward()\n",
    "\t\n",
    "\t# Update parameters using gradient descent\n",
    "\twith torch.no_grad():\n",
    "\t\tw -= learning_rate * w.grad\n",
    "\t\tb -= learning_rate * b.grad\n",
    "\t\tw.grad.zero_()\n",
    "\t\tb.grad.zero_()\n",
    "\t\n",
    "\tif (iteration + 1) % 1000 == 0 or iteration == 0:\n",
    "\t\tprint(f\"Iteration {iteration + 1}: Loss = {loss.item():.4f}, w = {w.item():.4f}, b = {b.item():.4f}\")\n",
    "\n",
    "# Plot the loss over iterations\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.plot(losses)\n",
    "plt.xlabel(\"Iteration\")\n",
    "plt.ylabel(\"Loss\")\n",
    "plt.title(\"Loss over Iterations\")\n",
    "\n",
    "# Plot the fitted curve\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.scatter(X, y, alpha=0.5, label=\"Data\")\n",
    "X_plot = np.linspace(X.min(), X.max(), 100).reshape(-1, 1)\n",
    "X_plot_torch = torch.tensor(X_plot, dtype=torch.float32)\n",
    "y_plot = torch.sigmoid(X_plot_torch @ w + b).detach().numpy()\n",
    "plt.plot(X_plot, y_plot, color=\"red\", label=f\"Fit: σ(w*x + b)\")\n",
    "plt.xlabel(\"X\")\n",
    "plt.ylabel(\"P(y=1)\")\n",
    "plt.title(\"Logistic Regression Fit\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"\\nFinal parameters: w = {w.item():.4f}, b = {b.item():.4f}\")\n"
   ]
